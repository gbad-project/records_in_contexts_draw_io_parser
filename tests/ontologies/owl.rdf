  <rdfs:Class rdf:about="#InverseFunctionalProperty">
    <rdfs:label>InverseFunctionalProperty</rdfs:label>
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:subClassOf rdf:resource="#ObjectProperty"/>
