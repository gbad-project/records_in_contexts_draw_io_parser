<https://data.archives.gov.on.ca/KB/RecordSet/F%20883-2-3/Hanna%20Newcombe%20files%20-%20general>
  a rico:RecordSet;
  rdfs:label "F 883-2-3 (Record Set)";
  rico:creationDate "1972-1973";
  rico:generalDescription "Originally housed in Box 62.";
  rico:hasOrHadIdentifier <https://data.archives.gov.on.ca/KB/CurrentReferenceCode/F%20883-2-3/Hanna%20Newcombe%20files%20-%20general>,
    <https://data.archives.gov.on.ca/KB/FormerCode/F%20883-2-3/Hanna%20Newcombe%20files%20-%20general>;
  rico:hasOrHadInstantiation <https://data.archives.gov.on.ca/KB/Instantiation/F%20883-2-3/Hanna%20Newcombe%20files%20-%20general/5b2d37e4-9ac3-55bf-ad82-0d18bdc2c60a>;
  rico:hasOrHadTitle <https://data.archives.gov.on.ca/KB/Title/F%20883-2-3/Hanna%20Newcombe%20files%20-%20general/5a2da353-a96f-5f22-aa3a-243f949388e4>;
  rico:isDirectlyIncludedIn <https://data.archives.gov.on.ca/KB/RecordSet/F%20883-2-3>;
  rico:isOrWasDescribedBy <https://data.archives.gov.on.ca/KB/ArchivalDescriptionRecord/F%20883-2-3/Hanna%20Newcombe%20files%20-%20general>,
    <https://data.archives.gov.on.ca/KB/FindingAidRecord/F%20883-2-3/Hanna%20Newcombe%20files%20-%20general>;
  rico:scopeAndContent "File consists of records pertaining to:  Cross-Cleavage in International Politics by A. J. Miller; records concerning the Canadian Political Science Association; Discontinuities in the Symbolic Environment: A Problem in Scaling Events by Edward E. Azar and Thomas N. Havener; Film Prospectus The Journey or The Geneva Semester on the United Nations System \"The student's place in the world of tomorrow - today\"; 1973 Report of the Center for Conflict Resolution; and Peaces and Futures A Symposium on Peace Research. ; Also included are:  University of Illinois campus map; records concerning  the Consortium on Peace Research, Education and Development; Reaction to Superstar A Preliminary Survey; Public Law 87-297, 87th Congress - Arms Control and Disarmament Act; A Historical Inventory of Peace Research by Clinton F. Fink; and Toward a Critical History of Peace Education by Clinton F. Fink." .

