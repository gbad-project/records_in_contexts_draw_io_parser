DataProperty:
  add:hiddenNotes

Individual: rr%3Atemplate%20%22KB%2FRecordSet%2F%7BREFD_FILE%7D
  Annotations:
    rdfs:label "rr:template \"KB/RecordSet/{REFD_FILE}"
  Types: rico:RecordSet
  Facts:
    rico:hasRecordSetType rr%3Atemplate%20%22Schema%2FDescription-Listings%2FLevel%23%7BLEVELDES%7D%22,
    rico:scopeAndContent "rml:reference   \"SCOPE\"",
    rico:history "rml:reference  \"CUSTOD\"",
    rico:history "rml:reference  \"ISA\"",
    rico:history "rml:reference \"ADMBIO\"",
    rico:hasOrHadInstantiation rr%3Atemplate%20%22KB%2FInstantiation%2F%7BREFD_FILE%7D%2F%7BUUID_INSTANTIATION_1%7D%22,
    rico:conditionsOfAccess "rml:reference  \"REST\"",
    rico:conditionsOfAccess "rml:reference  \"RESTRTX\"",
    rico:conditionsOfUse "rml:reference \"TGU\"",
    rico:generalDescription "rml:reference  \"AVAIL\"",
    rico:generalDescription "rml:reference  \"NOTES\"",
    rico:generalDescription "rml:reference \"ASSMAT\"",
    rico:generalDescription "rml:reference \"CMTD\"",
    rico:generalDescription "rml:reference \"FINDAID\"",
    rico:generalDescription "rml:reference \"RELMAT\"",
    rico:isOrWasDescribedBy rr%3Atemplate%20%22KB%2FArchivalDescriptionRecord%2F%7BREFD_FILE%7D%22,
    rico:isOrWasDescribedBy rr%3Atemplate%20%22KB%2FFindingAidRecord%2F%7BREFD_FILE%7D%22,
    rico:accruals "rml:reference \"ACCRUAL\"",
    rico:hasOrHadIdentifier rr%3Atemplate%20%22KB%2FCurrentReferenceCode%2F%7BREFD_FILE%7D%22,
    rico:hasOrHadIdentifier rr%3Atemplate%20%22KB%2FFormerCode%2F%7BREFD_FILE%7D%22,
    rico:hasCreator rr%3Atemplate%20%22KB%2FAgent%2F%7BINDEXPROV%7D%22,
    rico:hasOrHadTitle rr%3Atemplate%20%22KB%2FTitle%2F%7BREFD_FILE%7D%2F%7BUUID_RECORDSET%7D%22,
    rico:hasOrHadSubject rr%3Atemplate%20%22KB%2FAgent%2F%7BINDEXSUB%7D%22,
    rico:isAssociatedWithPlace rr%3Atemplate%20%22KB%2FPlace%2F%7BINDEXGEO_1..21%7D%22,
    rico:hasContentOfType rr%3Atemplate%20%22Schema%2FDescription-Listings%2FContentType%23%7BGMD_1..8%7D%22,
    rico:creationDate "rml:reference \"DATECR\"",
    rico:isDirectlyIncludedIn rr%3Atemplate%20%22KB%2FRecordSet%2F%7BREFD_HIGHER%7D,
    rico:isDirectlyIncludedIn rr%3Atemplate%20%22KB%2FRecordSet%2F%7BREF_ADD%7D,
    add:hiddenNotes "rml:reference \"HIDDENNOTES\"",
    rico:date "rml:reference \"DATEACM\""

