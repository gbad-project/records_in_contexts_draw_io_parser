<Schema/Mapping#rr_template___RICO_VERSION___REFD__RecordSet_1> a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
            rml:source "gbad/mapping/source/description_tailshuf_100.csv" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rml:reference "RESTRTX " ] ;
            rr:predicate rico:conditionsOfAccess ],
        [ rr:objectMap [ rml:reference "REST" ] ;
            rr:predicate rico:conditionsOfAccess ],
        [ rr:objectMap [ rml:reference "FINDAID" ] ;
            rr:predicate rico:generalDescription ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template___RICO_VERSION___INDEXPROV__Thing_1_> ] ;
            rr:predicate rico:hasCreator ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template___RICO_VERSION___REFD__Instantiation_1_> ] ;
            rr:predicate rico:hasOrHadInstantiation ],
        [ rr:objectMap [ rml:reference "AVAIL" ] ;
            rr:predicate rico:generalDescription ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template___RICO_VERSION___REFD__Identifier_1_> ] ;
            rr:predicate rico:hasOrHadIdentifier ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template___RICO_VERSION___REFD_HIGHER__RecordSet_1> ] ;
            rr:predicate rico:isDirectlyIncludedIn ],
        [ rr:objectMap [ rml:reference "HIDDENNOTES" ] ;
            rr:predicate rico:generalDescription ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__Schema_Description-Listings_RecordSetType__LEVELDES__> ] ;
            rr:predicate rico:hasRecordSetType ],
        [ rr:objectMap [ rml:reference "CMTD" ] ;
            rr:predicate rico:generalDescription ],
        [ rr:objectMap [ rml:reference "RELMAT" ] ;
            rr:predicate rico:generalDescription ],
        [ rr:objectMap [ rml:reference "ADMBIO" ] ;
            rr:predicate rico:history ],
        [ rr:objectMap [ rml:reference "ACCRUAL" ] ;
            rr:predicate rico:accruals ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template___RICO_VERSION___REF_ADD__RecordSet_1> ] ;
            rr:predicate rico:isDirectlyIncludedIn ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template___RICO_VERSION___REFD__Identifier_2_> ] ;
            rr:predicate rico:hasOrHadIdentifier ],
        [ rr:objectMap [ rml:reference "CUSTOD" ] ;
            rr:predicate rico:history ],
        [ rr:objectMap [ rml:reference "NOTES" ] ;
            rr:predicate rico:generalDescription ],
        [ rr:objectMap [ rml:reference "TGU" ] ;
            rr:predicate rico:conditionsOfUse ],
        [ rr:objectMap [ rml:reference "DATECR" ] ;
            rr:predicate rico:creationDate ],
        [ rr:objectMap [ rr:template "{RICO_VERSION}/{REFD}/RecordSet/1" ;
                    rr:termType rr:Literal ] ;
            rr:predicate rdfs:label ],
        [ rr:objectMap [ rml:reference "ASSMAT" ] ;
            rr:predicate rico:generalDescription ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template___RICO_VERSION___REFD__Title_1_> ] ;
            rr:predicate rico:hasOrHadTitle ],
        [ rr:objectMap [ rml:reference "ISA" ] ;
            rr:predicate rico:history ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template___RICO_VERSION___INDEXSUB__Thing_1_> ] ;
            rr:predicate rico:hasOrHadSubject ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template___RICO_VERSION___REFD__Record_2_> ] ;
            rr:predicate rico:isOrWasDescribedBy ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template___RICO_VERSION___REFD__Record_1_> ] ;
            rr:predicate rico:isOrWasDescribedBy ],
        [ rr:objectMap [ rml:reference "SCOPE" ] ;
            rr:predicate rico:scopeAndContent ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__Schema_Description-Listings_ContentType__GMD__> ] ;
            rr:predicate rico:hasContentOfType ],
        [ rr:objectMap [ rml:reference "DATEACM" ] ;
            rr:predicate rico:date ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template___RICO_VERSION___INDEXGEO__Thing_1_> ] ;
            rr:predicate rico:isAssociatedWithPlace ] ;
    rr:subjectMap [ fnml:functionValue [ rr:predicateObjectMap [ rr:objectMap [ fnml:functionValue [ rr:predicateObjectMap [ rr:objectMap [ rr:constant idlab-fn:isNull ] ;
                                                    rr:predicate fno:executes ],
                                                [ rr:objectMap [ rml:reference "RICO_VERSION" ] ;
