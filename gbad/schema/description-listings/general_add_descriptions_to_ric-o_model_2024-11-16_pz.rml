    rr:predicateObjectMap [ rr:objectMap [ rr:template "{MODDATE} (Date)" ;
                    rr:termType rr:Literal ] ;
            rr:predicate rdfs:label ],
        [ rr:objectMap [ rml:reference "MODDATE" ] ;
