@base <https://data.archives.gov.on.ca/> .
@prefix : <https://data.archives.gov.on.ca/Schema/Mapping#> .
@prefix add: <https://data.archives.gov.on.ca/Schema/Description-Listings/> .
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno: <https://w3id.org/function/ontology#> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix idlab-fn: <https://w3id.org/imec/idlab/function#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rico: <https://www.ica.org/standards/RiC/ontology#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .

<Schema/Mapping#add_accumulationDate> a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
            rml:source "gbad/mapping/source/DESCRIPTION.csv" ] ;
    rr:predicateObjectMap [ rr:object rico:date ;
            rr:predicate rdfs:subPropertyOf ],
        [ rr:object rico:RecordResource ;
            rr:predicate rdfs:domain ],
        [ rr:object rdfs:Literal ;
            rr:predicate rdfs:range ],
        [ rr:object rico:Instantiation ;
            rr:predicate rdfs:domain ] ;
    rr:subjectMap [ rr:class owl:DatatypeProperty ;
            rr:constant "https://data.archives.gov.on.ca/Schema/Description-Listings/accumulationDate" ] .

