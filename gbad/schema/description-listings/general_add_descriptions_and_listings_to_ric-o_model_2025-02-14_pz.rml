<Schema/Mapping#rdfs_label> a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
            rml:source "gbad/mapping/source/DESCRIPTION.csv" ] ;
    rr:subjectMap [ rr:class owl:DatatypeProperty ;
            rr:constant "http://www.w3.org/2000/01/rdf-schema#label" ] .

<Schema/Mapping#rr_template__KB_RecordSet__REFD_> a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
            rml:source "gbad/mapping/source/DESCRIPTION.csv" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Title__TITLE__> ] ;
            rr:predicate rico:hasOrHadTitle ],
        [ rr:objectMap [ rml:reference "DATECR" ] ;
            rr:predicate rico:creationDate ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_20__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_15__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_RecordSet__REFD_HIGHER_> ] ;
            rr:predicate rico:isDirectlyIncludedIn ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_3__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rml:reference "ASSMAT" ] ;
            rr:predicate <Schema/Description-Listings/associatedMaterial> ],
        [ rr:objectMap [ rml:reference "NOTES" ] ;
            rr:predicate <Schema/Description-Listings/notes> ],
        [ rr:objectMap [ rml:reference "RELMAT" ] ;
            rr:predicate <Schema/Description-Listings/relatedMaterial> ],
        [ rr:objectMap [ rml:reference "HIDDENNOTES" ] ;
            rr:predicate <Schema/Description-Listings/hiddenNotes> ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__Schema_Description-Listings_ContentType__GMD_6__> ] ;
            rr:predicate rico:hasContentOfType ],
        [ rr:objectMap [ rr:template "{REF_FILE} - {TITLE} (Record Set)" ;
                    rr:termType rr:Literal ] ;
            rr:predicate rdfs:label ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_21__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_7__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Instantiation__REFD___UUID_INSTANTIATION_1__> ] ;
            rr:predicate rico:hasOrHadInstantiation ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Instantiation__REF_FILE___UUID_INSTANTIATION_1__> ] ;
            rr:predicate rico:hasOrHadInstantiation ],
        [ rr:objectMap [ rml:reference "RESTRTX" ] ;
            rr:predicate rico:conditionsOfAccess ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_9__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_8__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__Schema_Description-Listings_ContentType__GMD_5__> ] ;
            rr:predicate rico:hasContentOfType ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_19__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_FormerCode__REFD__> ] ;
            rr:predicate rico:hasOrHadIdentifier ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_18__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_12__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Agent__INDEXSUB__> ] ;
            rr:predicate rico:hasOrHadSubject ],
        [ rr:objectMap [ rml:reference "ADMBIO" ] ;
            rr:predicate rico:history ],
        [ rr:objectMap [ rr:template "{REFD} - {TITLE} (Record Set)" ;
                    rr:termType rr:Literal ] ;
            rr:predicate rdfs:label ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_1__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_5__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_RecordSet__REF_ADD_> ] ;
            rr:predicate rico:isDirectlyIncludedIn ],
        [ rr:objectMap [ rml:reference "ACCRUAL" ] ;
            rr:predicate rico:accruals ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_2__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__Schema_Description-Listings_Level__LEVELDES__> ] ;
            rr:predicate rico:hasRecordSetType ],
        [ rr:objectMap [ rml:reference "ISA" ] ;
            rr:predicate <Schema/Description-Listings/immediateSourceOfAcquisition> ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_14__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_FindingAidRecord__REF_FILE__> ] ;
            rr:predicate rico:isOrWasDescribedBy ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__Schema_Description-Listings_ContentType__GMD_2__> ] ;
            rr:predicate rico:hasContentOfType ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Agent__INDEXPROV__> ] ;
            rr:predicate rico:hasCreator ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_FindingAidRecord__REFD__> ] ;
            rr:predicate rico:isOrWasDescribedBy ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_ArchivalDescriptionRecord__REFD__> ] ;
            rr:predicate rico:isOrWasDescribedBy ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_ArchivalDescriptionRecord__REF_FILE__> ] ;
            rr:predicate rico:isOrWasDescribedBy ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_16__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rml:reference "SCOPE" ] ;
            rr:predicate rico:scopeAndContent ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_FormerCode__REF_FILE__> ] ;
            rr:predicate rico:hasOrHadIdentifier ],
        [ rr:objectMap [ rml:reference "CUSTOD" ] ;
            rr:predicate <Schema/Description-Listings/custodialHistory> ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_CurrentReferenceCode__REF_FILE__> ] ;
            rr:predicate rico:hasOrHadIdentifier ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_CurrentReferenceCode__REFD__> ] ;
            rr:predicate rico:hasOrHadIdentifier ],
        [ rr:objectMap [ rml:reference "REST" ] ;
            rr:predicate rico:conditionsOfAccess ],
        [ rr:objectMap [ rml:reference "FINDAID" ] ;
            rr:predicate <Schema/Description-Listings/findingAidNote> ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_11__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__Schema_Description-Listings_ContentType__GMD_3__> ] ;
            rr:predicate rico:hasContentOfType ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_4__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_10__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rml:reference "CMTD" ] ;
            rr:predicate <Schema/Description-Listings/archivistComment> ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__Schema_Description-Listings_ContentType__GMD_4__> ] ;
            rr:predicate rico:hasContentOfType ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__Schema_Description-Listings_ContentType__GMD_7__> ] ;
            rr:predicate rico:hasContentOfType ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_17__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__Schema_Description-Listings_ContentType__GMD_1__> ] ;
            rr:predicate rico:hasContentOfType ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__Schema_Description-Listings_ContentType__GMD_8__> ] ;
            rr:predicate rico:hasContentOfType ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_13__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rml:reference "TGU" ] ;
            rr:predicate rico:conditionsOfUse ],
        [ rr:objectMap [ rml:reference "AVAIL" ] ;
            rr:predicate <Schema/Description-Listings/availabilityOfOtherFormats> ],
        [ rr:objectMap [ rml:reference "DATEACM" ] ;
            rr:predicate <Schema/Description-Listings/accumulationDate> ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_6__> ] ;
            rr:predicate rico:isAssociatedWithPlace ] ;
    rr:subjectMap [ fnml:functionValue [ rr:predicateObjectMap [ rr:objectMap [ fnml:functionValue [ rr:predicateObjectMap [ rr:objectMap [ rml:reference "REFD" ] ;
                                                    rr:predicate idlab-fn:str ],
                                                [ rr:objectMap [ rr:constant idlab-fn:isNull ] ;
                                                    rr:predicate fno:executes ] ] ] ;
                            rr:predicate grel:bool_b ],
                        [ rr:objectMap [ rr:constant grel:controls_if ] ;
                            rr:predicate fno:executes ],
                        [ rr:objectMap [ rr:template "KB/RecordSet/{REFD}" ] ;
                            rr:predicate grel:any_false ] ] ;
            rr:class rico:RecordSet ] .

<Schema/Mapping#rr_template__KB_RecordSet__REFD__> a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
            rml:source "gbad/mapping/source/DESCRIPTION.csv" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Agent__OFFICEABC_1_> ] ;
            rr:predicate rico:hasCreator ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_CreationRelation__REFD___OFFICEABC_1___UUID_OFFICEABC_> ] ;
            rr:predicate rico:thingIsSourceOfRelation ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_CreationRelation__REF_FILE___OFFICEABC_2___UUID_OFFICEABC_> ] ;
            rr:predicate rico:thingIsSourceOfRelation ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Agent__OFFICEABC_2_> ] ;
            rr:predicate rico:hasCreator ],
        [ rr:objectMap [ rr:template "{REF_FILE} - {TITLE} (Record Set)" ;
                    rr:termType rr:Literal ] ;
            rr:predicate rdfs:label ],
        [ rr:objectMap [ rr:template "{REFD} - {TITLE} (Record Set)" ;
                    rr:termType rr:Literal ] ;
            rr:predicate rdfs:label ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_CreationRelation__REFD___OFFICEABC_2___UUID_OFFICEABC_> ] ;
            rr:predicate rico:thingIsSourceOfRelation ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_CreationRelation__REF_FILE___OFFICEABC_1___UUID_OFFICEABC_> ] ;
            rr:predicate rico:thingIsSourceOfRelation ] ;
    rr:subjectMap [ fnml:functionValue [ rr:predicateObjectMap [ rr:objectMap [ rr:constant grel:controls_if ] ;
                            rr:predicate fno:executes ],
                        [ rr:objectMap [ fnml:functionValue [ rr:predicateObjectMap [ rr:objectMap [ rr:constant idlab-fn:isNull ] ;
                                                    rr:predicate fno:executes ],
                                                [ rr:objectMap [ rml:reference "REFD" ] ;
                                                    rr:predicate idlab-fn:str ] ] ] ;
                            rr:predicate grel:bool_b ],
                        [ rr:objectMap [ rr:template "KB/RecordSet/{REFD}" ] ;
                            rr:predicate grel:any_false ] ] ;
            rr:class rico:RecordSet ] .

<Schema/Mapping#rr_template__KB_RecordSet__REF_FILE_> a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
            rml:source "gbad/mapping/source/DESCRIPTION.csv" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_Place__INDEXGEO_10__> ] ;
            rr:predicate rico:isAssociatedWithPlace ],
        [ rr:objectMap [ rr:template "{REFD} - {TITLE} (Record Set)" ;
                    rr:termType rr:Literal ] ;
            rr:predicate rdfs:label ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_RecordSet__REF_ADD_> ] ;
            rr:predicate rico:isDirectlyIncludedIn ],
