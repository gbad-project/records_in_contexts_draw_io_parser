<Schema/Mapping#rr_template__KB_Agent__OFFICEABC_2_> a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
            rml:source "gbad/mapping/source/description_tailshuf_100.csv" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:template "{OFFICEABC_2} (Agent)" ;
                    rr:termType rr:Literal ] ;
            rr:predicate rdfs:label ] ;
    rr:subjectMap [ fnml:functionValue [ rr:predicateObjectMap [ rr:objectMap [ rr:constant grel:controls_if ] ;
                            rr:predicate fno:executes ],
                        [ rr:objectMap [ fnml:functionValue [ rr:predicateObjectMap [ rr:objectMap [ rml:reference "OFFICEABC_2" ] ;
                                                    rr:predicate idlab-fn:str ],
                                                [ rr:objectMap [ rr:constant idlab-fn:isNull ] ;
                                                    rr:predicate fno:executes ] ] ] ;
                            rr:predicate grel:bool_b ],
                        [ rr:objectMap [ rr:template "KB/Agent/{OFFICEABC_2}" ] ;
                            rr:predicate grel:any_false ] ] ;
            rr:class rico:CorporateBody ] .

