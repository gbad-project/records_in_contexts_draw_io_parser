@base <https://data.archives.gov.on.ca/> .
@prefix : <https://data.archives.gov.on.ca/Schema/Mapping#> .
@prefix add: <https://data.archives.gov.on.ca/Schema/Description-Listings/> .
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno: <https://w3id.org/function/ontology#> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix idlab-fn: <https://w3id.org/imec/idlab/function#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rico: <https://www.ica.org/standards/RiC/ontology#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .

<Schema/Mapping#add_hiddenNotes> a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
            rml:source "gbad/mapping/source/listings_3_tailshuf_100.csv" ] ;
    rr:subjectMap [ rr:class owl:DatatypeProperty ;
            rr:constant "https://data.archives.gov.on.ca/Schema/Description-Listings/hiddenNotes" ] .

<Schema/Mapping#auth_functionNote> a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
            rml:source "gbad/mapping/source/listings_3_tailshuf_100.csv" ] ;
    rr:subjectMap [ rr:class owl:DatatypeProperty ;
            rr:constant "https://data.archives.gov.on.ca/Schema/Authority/functionNote" ] .

<Schema/Mapping#auth_privateNote> a rr:TriplesMap ;
