    rr:subjectMap [ fnml:functionValue [ rr:predicateObjectMap [ rr:objectMap [ rr:template "Schema/Authority/Status#{STATUSA}" ] ;
                            rr:predicate grel:any_false ],
                        [ rr:objectMap [ fnml:functionValue [ rr:predicateObjectMap [ rr:objectMap [ rml:reference "STATUSA" ] ;
                                                    rr:predicate idlab-fn:str ],
                                                [ rr:objectMap [ rr:constant idlab-fn:isNull ] ;
                                                    rr:predicate fno:executes ] ] ] ;
                            rr:predicate grel:bool_b ],
                        [ rr:objectMap [ rr:constant grel:controls_if ] ;
                            rr:predicate fno:executes ] ] ;
            rr:class rico:RecordState ] .

