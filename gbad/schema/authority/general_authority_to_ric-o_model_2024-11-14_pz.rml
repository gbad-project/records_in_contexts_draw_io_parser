<Schema/Mapping#rr_template__KB_Rule__RULES__> a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
            rml:source "gbad/mapping/source/authority_head_101.csv" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:template "{RULES}" ;
                    rr:termType rr:Literal ] ;
            rr:predicate rdfs:label ] ;
    rr:subjectMap [ fnml:functionValue [ rr:predicateObjectMap [ rr:objectMap [ fnml:functionValue [ rr:predicateObjectMap [ rr:objectMap [ rml:reference "RULES" ] ;
                                                    rr:predicate idlab-fn:str ],
                                                [ rr:objectMap [ rr:constant idlab-fn:isNull ] ;
                                                    rr:predicate fno:executes ] ] ] ;
                            rr:predicate grel:bool_b ],
                        [ rr:objectMap [ rr:template "KB/Rule/{RULES}" ] ;
                            rr:predicate grel:any_false ],
                        [ rr:objectMap [ rr:constant grel:controls_if ] ;
                            rr:predicate fno:executes ] ] ;
            rr:class rico:Rule ] .

<Schema/Mapping#rr_template__Schema_Authority_Status__STATUSA__> a rr:TriplesMap ;
