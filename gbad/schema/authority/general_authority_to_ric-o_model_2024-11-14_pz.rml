<Schema/Mapping#rr_template__KB_AgentIdentifier__REFA__> a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
            rml:source "gbad/mapping/source/authority_head_101.csv" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:template "{REFA}" ;
                    rr:termType rr:Literal ] ;
            rr:predicate rdfs:label ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_constant__https___data_archives_gov_on_ca_Schema_Authority_AgentIdentifier_Agency_Reference_Code_> ] ;
            rr:predicate rico:hasIdentifierType ],
        [ rr:objectMap [ rml:reference "REFA" ] ;
            rr:predicate rico:normalizedValue ] ;
    rr:subjectMap [ fnml:functionValue [ rr:predicateObjectMap [ rr:objectMap [ rr:template "KB/AgentIdentifier/{REFA}" ] ;
                            rr:predicate grel:any_false ],
                        [ rr:objectMap [ fnml:functionValue [ rr:predicateObjectMap [ rr:objectMap [ rml:reference "REFA" ] ;
                                                    rr:predicate idlab-fn:str ],
                                                [ rr:objectMap [ rr:constant idlab-fn:isNull ] ;
                                                    rr:predicate fno:executes ] ] ] ;
                            rr:predicate grel:bool_b ],
                        [ rr:objectMap [ rr:constant grel:controls_if ] ;
                            rr:predicate fno:executes ] ] ;
