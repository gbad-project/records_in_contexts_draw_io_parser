<Schema/Mapping#rr_constant__https___data_archives_gov_on_ca_Schema_Authority_AgentIdentifier_Agency_Reference_Code_> a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
            rml:source "gbad/mapping/source/authority_head_101.csv" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:template "Authority/AgentIdentifier%23Agency%20Reference%20Code" ;
                    rr:termType rr:Literal ] ;
            rr:predicate rdfs:label ] ;
    rr:subjectMap [ rr:class rico:IdentifierType ;
            rr:constant <Schema/Authority/AgentIdentifier%23Agency%20Reference%20Code> ] .

<Schema/Mapping#rr_constant__https___data_archives_gov_on_ca_Schema_Authority_AuthorityRecord_> a rr:TriplesMap ;
