<Schema/Mapping#rr_template__KB_Agent__CONTAG_10__> a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
            rml:source "gbad/mapping/source/AUTHORITY.csv" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:template "{CONTAG_10} (Agent)" ;
                    rr:termType rr:Literal ] ;
            rr:predicate rdfs:label ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_AgentControlRelation__CONTAG_10___HEADING___UUID__> ] ;
            rr:predicate rico:thingIsSourceOfRelation ] ;
    rr:subjectMap [ fnml:functionValue [ rr:predicateObjectMap [ rr:objectMap [ fnml:functionValue [ rr:predicateObjectMap [ rr:objectMap [ rr:constant idlab-fn:isNull ] ;
                                                    rr:predicate fno:executes ],
                                                [ rr:objectMap [ rml:reference "CONTAG_10" ] ;
                                                    rr:predicate idlab-fn:str ] ] ] ;
                            rr:predicate grel:bool_b ],
                        [ rr:objectMap [ rr:constant grel:controls_if ] ;
                            rr:predicate fno:executes ],
                        [ rr:objectMap [ rr:template "KB/Agent/{CONTAG_10}" ] ;
                            rr:predicate grel:any_false ] ] ;
            rr:class rico:CorporateBody ] .

<Schema/Mapping#rr_template__KB_Agent__CONTAG_11__> a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
            rml:source "gbad/mapping/source/AUTHORITY.csv" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_template__KB_AgentControlRelation__CONTAG_11___HEADING___UUID__> ] ;
            rr:predicate rico:thingIsSourceOfRelation ],
        [ rr:objectMap [ rr:template "{CONTAG_11} (Agent)" ;
                    rr:termType rr:Literal ] ;
            rr:predicate rdfs:label ] ;
    rr:subjectMap [ fnml:functionValue [ rr:predicateObjectMap [ rr:objectMap [ rr:template "KB/Agent/{CONTAG_11}" ] ;
                            rr:predicate grel:any_false ],
                        [ rr:objectMap [ rr:constant grel:controls_if ] ;
                            rr:predicate fno:executes ],
                        [ rr:objectMap [ fnml:functionValue [ rr:predicateObjectMap [ rr:objectMap [ rr:constant idlab-fn:isNull ] ;
                                                    rr:predicate fno:executes ],
                                                [ rr:objectMap [ rml:reference "CONTAG_11" ] ;
                                                    rr:predicate idlab-fn:str ] ] ] ;
                            rr:predicate grel:bool_b ] ] ;
            rr:class rico:CorporateBody ] .

