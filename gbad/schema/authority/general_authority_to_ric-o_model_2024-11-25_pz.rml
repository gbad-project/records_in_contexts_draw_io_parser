    rr:predicateObjectMap [ rr:objectMap [ rr:template "Source Note" ;
                    rr:termType rr:Literal ] ;
            rr:predicate rdfs:label ],
        [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_constant__https___www_ica_org_standards_RiC_ontology_generalDescription_> ] ;
