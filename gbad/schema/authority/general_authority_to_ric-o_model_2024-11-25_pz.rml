    rr:subjectMap [ rr:class owl:DatatypeProperty ;
            rr:constant "https://data.archives.gov.on.ca/Schema/Authority/privateNote" ] .

<Schema/Mapping#auth_sourceNote> a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
            rml:source "gbad/mapping/source/AUTHORITY.csv" ] ;
    rr:subjectMap [ rr:class owl:DatatypeProperty ;
            rr:constant "https://data.archives.gov.on.ca/Schema/Authority/sourceNote" ] .

<Schema/Mapping#rr_constant__https___data_archives_gov_on_ca_Schema_Authority_functionNote_> a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
            rml:source "gbad/mapping/source/AUTHORITY.csv" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:parentTriplesMap <Schema/Mapping#rr_constant__https___www_ica_org_standards_RiC_ontology_generalDescription_> ] ;
            rr:predicate rdfs:subPropertyOf ],
        [ rr:objectMap [ rr:template "Function Note" ;
                    rr:termType rr:Literal ] ;
            rr:predicate rdfs:label ] ;
    rr:subjectMap [ rr:class owl:DatatypeProperty ;
            rr:constant <Schema/Authority/functionNote> ] .

<Schema/Mapping#rr_constant__https___data_archives_gov_on_ca_Schema_Authority_privateNote_> a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
