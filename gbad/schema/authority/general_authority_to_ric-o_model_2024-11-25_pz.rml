            rr:constant <Schema/Authority/privateNote> ] .

<Schema/Mapping#rr_constant__https___data_archives_gov_on_ca_Schema_Authority_sourceNote_> a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
